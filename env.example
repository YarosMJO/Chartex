# Chartex Environment Configuration
# Скопіюйте цей файл як .env та налаштуйте змінні

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/chartex?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=chartex

# Backend Configuration
NODE_ENV=production
PORT=5000
API_URL=http://localhost:5000/api

# Frontend Configuration
FRONTEND_URL=http://localhost:80

# Firebase Admin SDK Configuration (для backend)
# Отримайте ці дані з Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=chartex-2eae7
FIREBASE_CLIENT_EMAIL=your-firebase-admin@chartex-2eae7.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----\n"

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:80,chrome-extension://your-extension-id
